# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# OS
.DS_Store

# Runtime state — regenerated by the reader; never commit your own car's data.
# Repo-wide, not anchored to web/: a database or state file may be created at
# the repo root, under a future data/ directory, or per vehicle profile.
*.db
*.db-wal
*.db-shm
*.db-journal
*_state.json
*_state.json.tmp
web/leaf_battery.db
web/leaf_battery.db-wal
web/leaf_battery.db-shm
web/leaf_battery.db-journal
web/retention.json
web/retention.json.tmp
web/battery_state.json
web/battery_state.json.tmp

# Replay mode (--adapter replay) writes here, never to the real store/state
web/replay_*.db
web/replay_*.db-wal
web/replay_*.db-shm
web/replay_*_state.json
web/replay_*_state.json.tmp
web/reader.pause
web/tiles.json
web/tiles.json.tmp

# Legacy captures and logs from before the SQLite store (large / personal)
web/battery_history.json
battery_log_*.jsonl
*.log

# Assistant-harness: everything local stays out. Nothing under .claude/ is
# tracked today (git ls-files .claude/ is empty), so ignore the whole tree
# rather than un-ignoring directories whose future contents — local agent
# definitions, session context, absolute paths — would be committed silently.
# To share one file, add an explicit negation for that exact file.
.claude/

# Local-only research, captures, and per-machine config
research/
config.local.json

# Per-car calibration offsets
web/calibration.json
web/calibration.json.tmp

# Named tile layouts (personal)
web/layouts.json
web/layouts.json.tmp

# Simulator mode (--adapter sim) writes here, never to the real store/state.
# `hakake_sim.py --generate` defaults to web/sim_history.db and writes a
# _state.json beside it, so the same patterns cover generated history; an
# explicit --out elsewhere is caught by the repo-wide *.db / *_state.json
# rules above. Generated databases are synthetic and are never committed.
web/sim_*.db
web/sim_*.db-wal
web/sim_*.db-shm
web/sim_*.db-journal
web/sim_*_state.json
web/sim_*_state.json.tmp

# simulator cockpit layout (personal, like web/tiles.json)
web/sim_tiles.json
web/sim_tiles.json.tmp
